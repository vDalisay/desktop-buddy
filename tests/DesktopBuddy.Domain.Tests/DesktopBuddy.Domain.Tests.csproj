<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pure C# unit tests (xUnit) for DesktopBuddy.Domain. Runs with `dotnet test`
    and no Godot runtime. This is the layer-1 test project from TEST_PLAN.md.
    It is excluded from the Godot game assembly via DefaultItemExcludes in
    DesktopBuddy.csproj, and from release exports.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DesktopBuddy.Domain.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\domain\DesktopBuddy.Domain\DesktopBuddy.Domain.csproj" />
  </ItemGroup>

  <!-- Persistence stores/coordinator are managed-only runtime code. Link them
       into the pure test assembly so fault injection needs no Godot process. -->
  <ItemGroup>
    <Compile Include="..\..\src\Persistence\InMemoryProgressStore.cs" Link="RuntimePersistence\InMemoryProgressStore.cs" />
    <Compile Include="..\..\src\Persistence\PersistenceWork.cs" Link="RuntimePersistence\PersistenceWork.cs" />
    <Compile Include="..\..\src\Persistence\JsonProgressStore.cs" Link="RuntimePersistence\JsonProgressStore.cs" />
    <Compile Include="..\..\src\Persistence\SaveCoordinator.cs" Link="RuntimePersistence\SaveCoordinator.cs" />
    <Compile Include="..\..\src\Persistence\Characters\CharacterSelectionState.cs" Link="RuntimePersistence\CharacterSelectionState.cs" />
    <Compile Include="..\..\src\Persistence\Characters\CharacterPaths.cs" Link="RuntimePersistence\CharacterPaths.cs" />
    <Compile Include="..\..\src\Persistence\Characters\CharacterStoreResults.cs" Link="RuntimePersistence\CharacterStoreResults.cs" />
    <Compile Include="..\..\src\Persistence\Characters\CharacterStore.cs" Link="RuntimePersistence\CharacterStore.cs" />
    <Compile Include="..\..\src\Persistence\Characters\CharacterPaintStore.cs" Link="RuntimePersistence\CharacterPaintStore.cs" />
    <Compile Include="..\..\src\Persistence\Characters\BrowserCharacterJson.cs" Link="RuntimePersistence\BrowserCharacterJson.cs" />
    <Compile Include="..\..\src\App\GameClock.cs" Link="RuntimeLifecycle\GameClock.cs" />
    <Compile Include="..\..\src\Economy\EconomyService.cs" Link="RuntimeEconomy\EconomyService.cs" />
    <Compile Include="..\..\src\CharacterEditor\CharacterSlotEntitlementState.cs" Link="RuntimeCharacterEditor\CharacterSlotEntitlementState.cs" />
    <Compile Include="..\..\src\Persistence\EnvironmentPaintStore.cs" Link="RuntimePersistence\EnvironmentPaintStore.cs" />
    <Compile Include="..\..\src\Persistence\Characters\ICharacterFileSystem.cs" Link="RuntimePersistence\ICharacterFileSystem.cs" />
    <Compile Include="..\..\src\Persistence\Characters\PaintPngCodec.cs" Link="RuntimePersistence\PaintPngCodec.cs" />
    <Compile Include="..\..\src\App\ProgressReset.cs" Link="RuntimePersistence\ProgressReset.cs" />
    <Compile Include="..\..\src\Work\WorkFirstEntryRewardService.cs" Link="RuntimeWork\WorkFirstEntryRewardService.cs" />

    <!-- Workshop's validation/staging/emulator layer is deliberately managed-only. Linking it
         here proves hostile-content and async-social behavior without Steam or Godot. -->
    <Compile Include="..\..\src\Persistence\Sharing\ShareFolderReader.cs" Link="RuntimeSharing\ShareFolderReader.cs" />
    <Compile Include="..\..\src\Persistence\Sharing\WorkshopStagingStore.cs" Link="RuntimeSharing\WorkshopStagingStore.cs" />
    <Compile Include="..\..\src\Persistence\Sharing\WorkshopProvenanceStore.cs" Link="RuntimeSharing\WorkshopProvenanceStore.cs" />
    <Compile Include="..\..\src\Persistence\Sharing\RoomPaintingLibraryStore.cs" Link="RuntimeSharing\RoomPaintingLibraryStore.cs" />
    <Compile Include="..\..\src\Platform\Steam\SteamWorkshopContracts.cs" Link="RuntimeSharing\SteamWorkshopContracts.cs" />
    <Compile Include="..\..\src\Platform\Steam\DirectoryWorkshopTransport.cs" Link="RuntimeSharing\DirectoryWorkshopTransport.cs" />
    <Compile Include="..\..\src\Platform\Steam\WorkshopPublishCallbackLane.cs" Link="RuntimeSharing\WorkshopPublishCallbackLane.cs" />
    <Compile Include="..\..\src\Sharing\ShareTransferModels.cs" Link="RuntimeSharing\ShareTransferModels.cs" />
    <Compile Include="..\..\src\Sharing\RoomShareImporter.cs" Link="RuntimeSharing\RoomShareImporter.cs" />
    <Compile Include="..\..\src\Sharing\CharacterShareExporter.cs" Link="RuntimeSharing\CharacterShareExporter.cs" />
    <Compile Include="..\..\src\Sharing\CharacterShareImporter.cs" Link="RuntimeSharing\CharacterShareImporter.cs" />
    <Compile Include="..\..\src\Sharing\CharacterSharePayloadValidator.cs" Link="RuntimeSharing\CharacterSharePayloadValidator.cs" />
  </ItemGroup>

</Project>
