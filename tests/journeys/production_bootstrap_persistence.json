        "precondition": "scene_upgraded",
        "expected_wallet_milli": 123000,
        "expected_work_keyboard": 77,
        "expected_actor_count": 2
      },
      "assertions": [
        { "predicate": "sandbox_composed", "equals": true },
        { "predicate": "tag_next_fest", "equals": true },
        { "predicate": "split_scene_progress", "equals": true },
        { "predicate": "scene_actor_count_matches", "equals": true },
        { "predicate": "scene_actor_bindings_match", "equals": true },
        { "predicate": "scene_actors_share_player", "equals": true },
        { "predicate": "scene_actor_buddy_states_independent", "equals": true },
        { "predicate": "scene_actor_positions_distinct", "equals": true },
