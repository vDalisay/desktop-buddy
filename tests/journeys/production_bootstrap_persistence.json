{
  "id": "production_bootstrap_persistence",
  "description": "Tagged production-Bootstrap persistence and active Scene roster gate for Initial Demo refusal and Next Fest migration/recovery.",
  "milestone": 6,
  "phases": [
    {
      "id": "next_fest_legacy_migration",
      "build_scope": "next_fest",
      "expected_exit": 0,
      "setup": {
        "precondition": "legacy",
        "expected_wallet_milli": 123000,
        "expected_work_keyboard": 77,
        "expected_actor_count": 1
      },
      "assertions": [
        { "predicate": "sandbox_composed", "equals": true },
        { "predicate": "tag_next_fest", "equals": true },
        { "predicate": "split_scene_progress", "equals": true },
        { "predicate": "scene_manifest_exists", "equals": true },
        { "predicate": "wallet_preserved", "equals": true },
        { "predicate": "work_preserved", "equals": true },
        { "predicate": "scene_actor_count_matches", "equals": true },
        { "predicate": "scene_actor_bindings_match", "equals": true },
        { "predicate": "scene_actors_share_player", "equals": true }
      ]
    },
    {
      "id": "next_fest_committed_restart",
      "build_scope": "next_fest",
      "expected_exit": 0,
      "setup": {
        "precondition": "preserve",
        "expected_wallet_milli": 123000,
        "expected_work_keyboard": 77,
        "expected_actor_count": 1
      },
      "assertions": [
        { "predicate": "sandbox_composed", "equals": true },
        { "predicate": "tag_next_fest", "equals": true },
        { "predicate": "split_scene_progress", "equals": true },
        { "predicate": "scene_manifest_exists", "equals": true },
        { "predicate": "wallet_preserved", "equals": true },
        { "predicate": "work_preserved", "equals": true },
        { "predicate": "scene_actor_count_matches", "equals": true }
      ]
    },
    {
      "id": "next_fest_incomplete_promotion",
      "build_scope": "next_fest",
      "expected_exit": 0,
      "setup": {
        "precondition": "incomplete_promotion",
        "expected_wallet_milli": 123000,
        "expected_work_keyboard": 77,
        "expected_actor_count": 1
      },
      "assertions": [
        { "predicate": "sandbox_composed", "equals": true },
        { "predicate": "tag_next_fest", "equals": true },
        { "predicate": "split_scene_progress", "equals": true },
        { "predicate": "scene_manifest_exists", "equals": true },
        { "predicate": "wallet_preserved", "equals": true },
        { "predicate": "work_preserved", "equals": true },
