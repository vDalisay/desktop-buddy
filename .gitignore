# Godot 4+ specific ignores
.godot/
/android/

# .NET / C# build output
bin/
obj/
*.user
*.suo

# Godot .NET mono artifacts / crash dumps
.mono/
mono_crash.*.json

# Export / build output (produced by the Windows export preset)
/build/
/export/

# Public-build protection cache. Never commit generated obfuscator state or encryption keys.
/.protected/
*.gdkey

# Diagnostics: logs and headless runner artifacts
*.log
/logs/
/artifacts/*
!/artifacts/.gdignore
/.artifacts/

# Asset Forge transient/synchronized developer state. Recipes and exported generated game
# content are committed separately; these directories are reproducible build/run scratch data.
/.asset-forge-staging/
/devtools/AssetForge/.generated/profiles/

# Development Steam app id — never committed; ships only via the release export path
steam_appid.txt

# Vendored Godot MCP runtime server with its own .git, node_modules, and dist/.
# Dev-only tooling; only the Godot scan marker is tracked in this repo.
/Mcp/*
!/Mcp/.gdignore

# Godot MCP server may inject this script at run time (dev-only, not ours)
mcp_interaction_server.gd
mcp_interaction_server.gd.uid

# NOTE: per-asset *.import files (e.g. icon.svg.import) are intentionally tracked.
.mcp/

# Claude Code local state, including agent worktrees holding full repo checkouts.
/.claude/
