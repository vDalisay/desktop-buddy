<Project>
  <!--
    Shared C# language configuration for every assembly in the solution
    (game, domain, tests). Godot.NET.Sdk imports this automatically, so the
    root game project inherits the same nullable/lang settings as the
    Godot-free projects. Keep this free of Godot- or gameplay-specific props.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!--
      Nullable violations are hard errors so the "no lost input / actionable
      warnings" discipline in AGENTS.md is enforced at build time. Other
      warnings (incl. Godot source-generator noise) stay warnings so a clean
      clone still builds in CI.
    -->
    <WarningsAsErrors>Nullable</WarningsAsErrors>
  </PropertyGroup>

  <!--
    C# comments are never emitted into IL. Shipping builds additionally disable every normal
    source-adjacent compiler artifact that could preserve source text or documentation for a
    decompiler/operator: external or embedded PDBs, XML documentation, and embedded source.
    Godot's player export uses ExportRelease; normal developer Debug/Release builds are unchanged.
    Directory.Build.targets complements this for Godot text code: GitHub Actions self-tests the
    lexical scrubber, removes project-owned .gd/.gdshader comments in the disposable checkout
    before Godot can import/package them, then verifies no removable comments remain.
  -->
  <PropertyGroup Condition=" '$(Configuration)' == 'ExportRelease' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EmbedAllSources>false</EmbedAllSources>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
