<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>DesktopBuddy</RootNamespace>
    <AssemblyName>DesktopBuddy.Visuals</AssemblyName>
  </PropertyGroup>

  <!-- The experimental static-LibGodot exporter needs static browser linking, while the
       native editor import still needs to load this project normally before export. -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <EnableDynamicLoading>false</EnableDynamicLoading>
  </PropertyGroup>
</Project>