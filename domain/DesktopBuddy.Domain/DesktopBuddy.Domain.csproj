<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DesktopBuddy.Domain — plain .NET class library. No Godot.NET.Sdk reference.
    Owns formulas, pain window, knockout timing, mood/trust rules, economy,
    statistics windows, save DTOs/migrations, platform-operation queue logic,
    tick-count timers, and the headless runner-argument contract.
    It must remain runnable under `dotnet test` with no Godot runtime, so no
    Godot native-backed types (StringName, Rid, GodotObject) may appear here.
    (ARCHITECTURE.md Sections 5 and 22.)
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DesktopBuddy.Domain</RootNamespace>
    <AssemblyName>DesktopBuddy.Domain</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Keep this standalone rule identical to the game project's derived scope so direct domain builds
    and scoped game builds agree. net10.0 is the disposable itch.io Web domain build and therefore
    fails closed even before the broader distribution profile supplies DesktopBuddyItchScope.
  -->
  <PropertyGroup>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' AND ('$(DesktopBuddyItchScope)' == 'true' OR '$(TargetFramework)' == 'net10.0') ">false</DesktopBuddyAchievementsScope>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' AND '$(DesktopBuddySteamDemoScope)' == 'true' AND '$(DesktopBuddyNextFestDemoScope)' != 'true' ">false</DesktopBuddyAchievementsScope>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' ">true</DesktopBuddyAchievementsScope>
  </PropertyGroup>

  <!-- No achievement IDs, rules, counters or reconciliation code exists in low-scope domain DLLs. -->
  <ItemGroup Condition=" '$(DesktopBuddyAchievementsScope)' != 'true' ">
    <Compile Remove="Achievements/**/*.cs" />
  </ItemGroup>

  <!-- The disposable itch.io Web project is the only net10.0 variant. Do not ship the
       developer economy benchmark/calibration implementation or its symbol information. -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <Compile Remove="Economy/Benchmark/**/*.cs" />
  </ItemGroup>

</Project>