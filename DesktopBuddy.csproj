<Project Sdk="Godot.NET.Sdk/4.6.1">

  <!--
    DesktopBuddy — the Godot game assembly (ARCHITECTURE.md Section 22).
    Godot.NET.Sdk globs **/*.cs under the project directory (the repo root),
    so standalone projects are excluded here and build as their own assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>DesktopBuddy</RootNamespace>
    <AssemblyName>DesktopBuddy</AssemblyName>
  </PropertyGroup>

  <!--
    Achievement content is a compile-time distribution capability, not a Godot runtime flag.

      itch.io                              -> excluded
      Initial Steam Demo                   -> excluded
      Steam Next Fest Demo                 -> included (local qualification only)
      Full Release                         -> included (publishes to the full-game AppID)

    The distribution hardening branch owns the broader build-profile/manifest work. These property
    names intentionally match that direction: Steam Demo is the family, Next Fest is the promoted
    Demo variant. Developer/test builds keep achievements unless a scope is explicitly selected.
  -->
  <PropertyGroup>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' AND '$(DesktopBuddyItchScope)' == 'true' ">false</DesktopBuddyAchievementsScope>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' AND '$(DesktopBuddySteamDemoScope)' == 'true' AND '$(DesktopBuddyNextFestDemoScope)' != 'true' ">false</DesktopBuddyAchievementsScope>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' ">true</DesktopBuddyAchievementsScope>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(DesktopBuddyAchievementsScope)' == 'true' ">
    <DefineConstants>$(DefineConstants);DESKTOP_BUDDY_ACHIEVEMENTS</DefineConstants>
  </PropertyGroup>

  <!--
    The low-scope builds retain only a tiny absent composition seam so shared Steam/Workshop
    composition does not need a parallel source tree. The rule engine, publisher and Steam adapter
    are physically absent from the game/domain assemblies and cannot be enabled by editing Godot
    feature tags in an exported PCK.
  -->
  <ItemGroup Condition=" '$(DesktopBuddyAchievementsScope)' == 'true' ">
    <Compile Remove="src/Achievements/AchievementBootstrap.Absent.cs" />
  </ItemGroup>

  <ItemGroup Condition=" '$(DesktopBuddyAchievementsScope)' != 'true' ">
    <Compile Remove="src/Achievements/AchievementBootstrap.cs" />
    <Compile Remove="src/Achievements/SteamAchievementPublisher.cs" />
    <Compile Remove="src/Platform/Steam/GodotSteamAchievementRemote.cs" />
  </ItemGroup>

  <!--
    Godot's experimental static-LibGodot Web exporter publishes the game as a browser-wasm
    application. Keep the native/desktop project unchanged, but enable the fork's required
    Web AOT path whenever Godot targets Web.
  -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <!--
    The disposable itch.io Web project is rewritten to net10.0 by CI. Harden only that browser
    build: keep AOT + full trimming, remove managed IL bodies after AOT, suppress browser/native
    debug maps and symbols, and keep WebCIL packaging. This cannot make client-delivered WASM
    secret, but it removes the easy managed-code/debugging path without changing native builds.
  -->
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <WasmNativeStrip>true</WasmNativeStrip>
    <WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>
    <WasmEmitSourceMap>false</WasmEmitSourceMap>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableDiagnostics>false</EnableDiagnostics>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefineConstants>$(DefineConstants);DESKTOP_BUDDY_PUBLIC_WEB</DefineConstants>
  </PropertyGroup>

  <!-- Developer-only scenarios must not be compiled into the public browser assembly. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <Compile Remove="src/Testing/**/*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Developer tooling/source trees must never enter the shipping game assembly. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);domain/**/*;tests/DesktopBuddy.Domain.Tests/**/*;devtools/**/*;authoring/**/*;shared/**/*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Command-line distribution properties are MSBuild global properties and naturally flow to
         referenced projects. Do not use AdditionalProperties here: the solution also builds the
         domain project directly, and a second property-qualified instance would race the same
         bin/obj outputs during parallel solution builds. -->
    <ProjectReference Include="domain\DesktopBuddy.Domain\DesktopBuddy.Domain.csproj" />
    <ProjectReference Include="shared\DesktopBuddy.Visuals\DesktopBuddy.Visuals.csproj" />
  </ItemGroup>

</Project>