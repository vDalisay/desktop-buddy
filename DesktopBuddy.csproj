<Project Sdk="Godot.NET.Sdk/4.6.1">

  <!--
    DesktopBuddy — the Godot game assembly (ARCHITECTURE.md Section 22).
    Godot.NET.Sdk globs **/*.cs under the project directory (the repo root),
    so standalone projects are excluded here and build as their own assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>DesktopBuddy</RootNamespace>
    <AssemblyName>DesktopBuddy</AssemblyName>
  </PropertyGroup>

  <!--
    Godot's experimental static-LibGodot Web exporter publishes the game as a browser-wasm
    application. Keep the native/desktop project unchanged, but enable the fork's required
    Web AOT path whenever Godot targets Web.
  -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'web' ">
    <EnableDynamicLoading>false</EnableDynamicLoading>
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>

  <!--
    The disposable itch.io Web project is rewritten to net10.0 by CI. Harden only that browser
    build: keep AOT + full trimming, remove managed IL bodies after AOT, suppress browser/native
    debug maps and symbols, and keep WebCIL packaging. This cannot make client-delivered WASM
    secret, but it removes the easy managed-code/debugging path without changing native builds.
  -->
  <!--
    The reduced itch.io distribution. itch is web-only — CI rewrites this project to net10.0 for
    that export and it is the only Web preset — so the web target is what selects the reduced
    scope, and DESKTOP_BUDDY_PUBLIC_WEB is its compile constant (owner confirmation 2026-09-07).

    Set this property directly to compile the same reduced surface on the normal desktop target:

        dotnet build DesktopBuddy.sln -p:DesktopBuddyItchScope=true

    That is the only way to prove the #if-guarded code still compiles without the excluded
    subsystems, short of the pinned Web fork the real export needs.
  -->
  <PropertyGroup>
    <DesktopBuddyItchScope Condition=" '$(DesktopBuddyItchScope)' == '' AND '$(TargetFramework)' == 'net10.0' ">true</DesktopBuddyItchScope>
    <DesktopBuddyItchScope Condition=" '$(DesktopBuddyItchScope)' == '' ">false</DesktopBuddyItchScope>
  </PropertyGroup>

  <!--
    Steam Demo is shared terminology for two different distributions. The Initial Steam Demo is
    physically reduced; the later Next Fest Demo intentionally retains the broader vertical slice.
    Derive one canonical Initial scope so a Next Fest build can set SteamDemoScope=true without
    accidentally losing Room Decorator or other Next Fest-only content.
  -->
  <PropertyGroup>
    <DesktopBuddySteamDemoScope Condition=" '$(DesktopBuddySteamDemoScope)' == '' ">false</DesktopBuddySteamDemoScope>
    <DesktopBuddyInitialSteamDemoScope Condition=" '$(DesktopBuddyInitialSteamDemoScope)' == '' AND '$(DesktopBuddySteamDemoScope)' == 'true' AND '$(DesktopBuddyNextFestDemoScope)' != 'true' ">true</DesktopBuddyInitialSteamDemoScope>
    <DesktopBuddyInitialSteamDemoScope Condition=" '$(DesktopBuddyInitialSteamDemoScope)' == '' ">false</DesktopBuddyInitialSteamDemoScope>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(DesktopBuddyInitialSteamDemoScope)' == 'true' ">
    <DefineConstants>$(DefineConstants);DESKTOP_BUDDY_STEAM_DEMO</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidateDesktopBuddyDistributionScope" BeforeTargets="CoreCompile">
    <Error Condition=" '$(DesktopBuddyItchScope)' == 'true' AND '$(DesktopBuddySteamDemoScope)' == 'true' "
           Text="Distribution scope rejected: itch and Steam Demo scopes cannot be enabled together." />
  </Target>

  <!--
    Achievement content is a compile-time distribution capability, not a Godot runtime flag.

      itch.io                              -> excluded
      Initial Steam Demo                   -> excluded
      Steam Next Fest Demo                 -> included (local qualification only)
      Full Release                         -> included (publishes to the full-game AppID)

    Developer/test builds keep achievements unless a distribution scope explicitly removes them.
    The itch scope is evaluated above so both the real net10.0 export and explicit hardened-scope
    validation fail closed before achievement source selection is evaluated.
  -->
  <PropertyGroup>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' AND ('$(DesktopBuddyItchScope)' == 'true' OR '$(TargetFramework)' == 'net10.0') ">false</DesktopBuddyAchievementsScope>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' AND '$(DesktopBuddyInitialSteamDemoScope)' == 'true' ">false</DesktopBuddyAchievementsScope>
    <DesktopBuddyAchievementsScope Condition=" '$(DesktopBuddyAchievementsScope)' == '' ">true</DesktopBuddyAchievementsScope>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(DesktopBuddyAchievementsScope)' == 'true' ">
    <DefineConstants>$(DefineConstants);DESKTOP_BUDDY_ACHIEVEMENTS</DefineConstants>
  </PropertyGroup>

  <!--
    Low-scope builds physically omit the first-party achievement runtime plus its Steam adapter.
    Shared Workshop composition is compile-gated, so editing exported feature tags cannot restore
    code that was never compiled into the distribution.
  -->
  <ItemGroup Condition=" '$(DesktopBuddyAchievementsScope)' != 'true' ">
    <Compile Remove="src/Achievements/**/*.cs" />
    <Compile Remove="src/Platform/Steam/GodotSteamAchievementRemote.cs" />
  </ItemGroup>

  <!--
    A build that goes to players. Godot's export-release path compiles ExportRelease, so every
    Steam Demo, Full Release and itch package is one; editor runs, `dotnet build` and the whole
    scenario/journey suite are not, and keep the developer tree.

    This exists because the developer scenario tree was shipping in the Windows builds. It is not
    dead weight there, it is a live unlock: Bootstrap routes a scenario argument to the TestRunner,
    and BuddyStudioUiCompositionScenario sets DemoScope.FullReleaseOverride = true. A Demo player
    could open full-release content from the command line of the shipped exe.
  -->
  <PropertyGroup>
    <DesktopBuddyShippingBuild Condition=" '$(DesktopBuddyShippingBuild)' == '' AND '$(Configuration)' == 'ExportRelease' ">true</DesktopBuddyShippingBuild>
    <DesktopBuddyShippingBuild Condition=" '$(DesktopBuddyShippingBuild)' == '' ">false</DesktopBuddyShippingBuild>
  </PropertyGroup>

  <!--
    Explicit Initial Demo validation must exercise the same no-dev-tools surface even when a matrix
    compiles it in Debug. This prevents test/scenario code from keeping references to implementation
    types that are intentionally absent from the player binary.
  -->
  <PropertyGroup Condition=" '$(DesktopBuddyShippingBuild)' == 'true' OR '$(DesktopBuddyItchScope)' == 'true' OR '$(DesktopBuddyInitialSteamDemoScope)' == 'true' ">
    <DefineConstants>$(DefineConstants);DESKTOP_BUDDY_NO_DEV_TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition=" '$(DesktopBuddyShippingBuild)' == 'true' OR '$(DesktopBuddyItchScope)' == 'true' OR '$(DesktopBuddyInitialSteamDemoScope)' == 'true' ">
    <Compile Remove="src/Testing/**/*.cs" />
  </ItemGroup>

  <!--
    Initial Steam Demo retains Paint Background, Work Mode, Workshop and the shared character
    schema/renderer, but Room Decorator is a Next Fest feature. Remove the implementation itself
    rather than trusting the mutable steam_demo/full_release feature list in the PCK.
  -->
  <ItemGroup Condition=" '$(DesktopBuddyInitialSteamDemoScope)' == 'true' ">
    <Compile Remove="src/Environment/DecorationLightProfileResource.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorationCatalogueResource.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorationLayer.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorationPresenter.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorationRegistry.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorationResource.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorationVisualFactory.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorator.Preferences.cs" />
    <Compile Remove="src/Environment/EnvironmentDecorator.cs" />
    <Compile Remove="src/Environment/EnvironmentPlacementController.cs" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(DesktopBuddyItchScope)' == 'true' ">
    <DefineConstants>$(DefineConstants);DESKTOP_BUDDY_PUBLIC_WEB</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
    <WasmStripILAfterAOT>true</WasmStripILAfterAOT>
    <WasmNativeStrip>true</WasmNativeStrip>
    <WasmNativeDebugSymbols>false</WasmNativeDebugSymbols>
    <WasmEmitSourceMap>false</WasmEmitSourceMap>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <DebuggerSupport>false</DebuggerSupport>
    <EnableDiagnostics>false</EnableDiagnostics>
    <EventSourceSupport>false</EventSourceSupport>
    <MetricsSupport>false</MetricsSupport>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Source the reduced distribution does not ship. Held back at compile time, not by a runtime
    boolean: feature tags live in the exported project settings inside an unencrypted .pck, so a
    gate that only switches a shipped feature off is a data edit away from being switched back on
    (see docs/ITCH_HARDENING_PLAN_2026-09-07.md).

    Buddy Studio's folder is deliberately split rather than globbed. The workspace UI goes; the
    cosmetic data types beside it stay, because the buddy still wears and saves cosmetics on itch —
    BuddyGeneratedCosmeticRegistry and the two GeneratedBuddyCosmetic*Resource types are used by the
    renderer, the editor session and character persistence. New Studio UI files belong on this list.
  -->
  <ItemGroup Condition=" '$(DesktopBuddyItchScope)' == 'true' ">
    <!-- Buddy Studio: workspace UI only. -->
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStudioWorkspace.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStudioWorkspace.CaptureStorePolish.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStudioWorkspace.Generated.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStudioWorkspace.PreviewNavigation.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStudioBootstrap.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStudioStartupProbe.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStudioThumbnailCache.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/BuddyStyleTastes.cs" />
    <Compile Remove="src/CharacterEditor/BuddyStudio/CharacterEditorHost.BuddyStudio.cs" />
    <Compile Remove="src/Onboarding/FirstSessionGuidanceController.Studio.cs" />

    <!--
      Paint Room and Room Decorator: the whole folder. EnvironmentCustomizationBootstrap already
      returned early under the itch scope, so none of it ran there — no decoration layer and no
      background presenter was ever constructed. Removing it changes nothing at runtime and takes
      the room-editing code and the decoration catalogue out of the assembly.
    -->
    <Compile Remove="src/Environment/**/*.cs" />

    <!--
      Steam Workshop. Remove the UI/composition, its staging/persistence implementation, and the
      Steam transport layer. Leaving Platform/Steam compiled would still ship the real Workshop
      client even though the visible Workshop surface had been removed.
    -->
    <Compile Remove="src/Sharing/**/*.cs" />
    <Compile Remove="src/Persistence/Sharing/**/*.cs" />
    <Compile Remove="src/Platform/Steam/**/*.cs" />

    <!--
      Work Mode. Needs real OS transparent windows, which a browser cannot provide, and the itch
      scope has always hidden it — Bootstrap.CharacterEditor already skipped its coordinator and
      ItchDistributionScopeBootstrap hid the command button after the fact.
    -->
    <Compile Remove="src/Work/**/*.cs" />
    <Compile Remove="src/Onboarding/FirstSessionGuidanceController.Work.cs" />

    <Compile Remove="src/Onboarding/FirstSessionGuidanceController.Background.cs" />
    <Compile Remove="src/Buddy/Behavior/RoomInterestBootstrap.Environment.cs" />
  </ItemGroup>

  <!-- The "no Buddy Studio" half of that seam is the one build that must not see both. -->
  <ItemGroup Condition=" '$(DesktopBuddyItchScope)' != 'true' ">
    <Compile Remove="src/Onboarding/FirstSessionGuidanceController.StudioAbsent.cs" />
    <Compile Remove="src/Onboarding/FirstSessionGuidanceController.BackgroundAbsent.cs" />
    <Compile Remove="src/Buddy/Behavior/RoomInterestBootstrap.EnvironmentAbsent.cs" />
    <Compile Remove="src/Onboarding/FirstSessionGuidanceController.WorkAbsent.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Developer tooling/source trees must never enter the shipping game assembly. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);domain/**/*;tests/DesktopBuddy.Domain.Tests/**/*;devtools/**/*;authoring/**/*;shared/**/*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="domain\DesktopBuddy.Domain\DesktopBuddy.Domain.csproj" />
    <ProjectReference Include="shared\DesktopBuddy.Visuals\DesktopBuddy.Visuals.csproj" />
  </ItemGroup>

</Project>